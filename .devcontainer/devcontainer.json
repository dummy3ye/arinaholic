{
  "name": "arinaholic (Node 24 + Bun 1.4.2)",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:5-24-bookworm",
  "features": {
    "ghcr.io/devcontainers-extra/features/bun:1": {
      "version": "1.4.2"
    }
  },
  "forwardPorts": [3000, 6006],
  "portsAttributes": {
    "3000": {
      "label": "Next.js dev",
      "onAutoForward": "notify"
    },
    "6006": {
      "label": "Storybook",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bun install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "vitest.explorer",
        "bradlc.vscode-tailwindcss",
        "editorconfig.editorconfig",
        "stylelint.vscode-stylelint"
      ]
    }
  }
}

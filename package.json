{
  "name": "arinaholic",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome ci --formatter-enabled=false .",
    "lint:fix": "biome check --write --formatter-enabled=false .",
    "lint:oxlint": "oxlint --deny-warnings",
    "lint:oxlint:fix": "oxlint --fix",
    "lint:styles": "stylelint \"src/**/*.{css,scss}\"",
    "lint:commit": "commitlint --from HEAD~1 --to HEAD --verbose",
    "format": "biome format --write .",
    "format:check": "biome ci --linter-enabled=false --assist-enabled=false .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "knip": "knip",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check": "bun run lint && bun run lint:oxlint && bun run lint:styles && bun run knip && bun run format:check && bun run typecheck && bun run test && bun run build && bun run build-storybook"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@vercel/speed-insights": "2.1.0",
    "@vitest/ui": "^5.1.1",
    "gray-matter": "^4.0.3",
    "katex": "^0.19.1",
    "lucide-react": "^1.76.0",
    "marked": "^18.2.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@biomejs/biome": "2.6.9",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "1.65.1",
    "@storybook/nextjs-vite": "10.6.9",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-istanbul": "5.1.2",
    "jsdom": "^31.0.1",
    "knip": "^6.47.0",
    "oxlint": "1.94.0",
    "sass": "1.108.2",
    "storybook": "10.6.9",
    "stylelint": "18.1.0",
    "stylelint-config-standard-scss": "18.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "^5.1.1"
  }
}
